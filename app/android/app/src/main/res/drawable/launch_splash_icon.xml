<!-- Deliberately empty.

     From Android 12 the platform draws the launch screen itself: the app's
     launcher icon centred on windowSplashScreenBackground. The legacy
     layer-list in launch_background.xml is ignored, so removing the mark there
     removed nothing on a modern device. This transparent drawable is how the
     mark is removed where it actually lives.

     GI Daily draws nothing at launch - see docs/PHASE-1.md D4. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#00000000" />
</vector>
